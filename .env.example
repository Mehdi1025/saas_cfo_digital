APP_NAME="Mini CFO Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Base de données (MySQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saas_cfo_digital
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail (mot de passe d'application Google — pas le mot de passe du compte)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=null
# MAIL_USERNAME=votre.adresse@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx
# MAIL_FROM_ADDRESS="votre.adresse@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Stripe (abonnement Copifi uniquement)
# Pour les webhooks en local : stripe listen (ou dashboard Stripe).
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLAN_NAME=Copifi
STRIPE_PLAN_PRICE=29.95
STRIPE_PLAN_PRICE_LABEL="29,95 €"
STRIPE_PLAN_CURRENCY=EUR

# -----------------------------------------------------------------------------
# Bridge (open banking / agregation bancaire)
# Sandbox : Demo Bank (ID 574), login success
# Declarer l URL de callback dans le dashboard Bridge :
# https://VOTRE_DOMAINE/banking/bridge/callback
# -----------------------------------------------------------------------------
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
BRIDGE_BASE_URL=https://api.bridgeapi.io/v3
BRIDGE_VERSION=2025-01-15
# Optionnel si APP_URL ne correspond pas au domaine enregistre chez Bridge
BRIDGE_CONNECT_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Google Auth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# -----------------------------------------------------------------------------
# Groq IA
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
